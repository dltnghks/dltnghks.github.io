NOTION_API_KEY=your_integration_token_here
NOTION_DATABASE_ID=your_database_id_here

# Optional: map local "/assets/..." image paths to public URLs in Notion
SITE_BASE_URL=https://your-domain.github.io
RAW_BASE_URL=https://raw.githubusercontent.com/owner/repo/main

# Optional: override Notion property names
NOTION_PROP_TITLE=Name
NOTION_PROP_DATE=Date
NOTION_PROP_TAGS=Tags
NOTION_PROP_CATEGORIES=Categories
NOTION_PROP_PUBLISHED=Published
NOTION_PROP_SLUG=Slug
NOTION_PROP_SOURCE_PATH=Source Path
